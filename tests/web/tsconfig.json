{
  // The site's own compiler options (apps/web/tsconfig.json), because these
  // tests import its sources and tsc checks every file it reaches under the
  // importing project's options; only the paths and the files differ.
  "extends": "../../apps/web/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "types": ["node"],
    "paths": {
      "@/*": ["../../apps/web/*"]
    },
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
