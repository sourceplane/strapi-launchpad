// GENERATED from wrangler.template.jsonc by tooling/wire — edit the
// template, not this file. The committed copy is the fixture render
// (`pnpm run wire:fixture`); every Orun lane renders its own environment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strapi-launchpad-web-stage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // No `vars`: the site's name is lib/site.ts (SITE_NAME), and the Strapi
  // URL is inlined by the build from the product's Orun secret STRAPI_URL
  // (component.yaml); until it is set the site renders its bundled sample
  // content. The preview secret is a Worker secret an owner sets with
  // `wrangler secret put` (the README's "Connecting Strapi").

  // The Next.js incremental cache — the `"use cache"` entries of every
  // Strapi read — in the bucket infra/terraform/cloudflare-r2 provisions.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "stg-strapi-launchpad-stage",
    },
  ],
  // The tag cache (which tags `revalidateTag` invalidated, and when) and the
  // revalidation queue: Durable Objects the generated Worker exports, created
  // by the migration on first deploy.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  // The queue revalidates a stale route by requesting it from the Worker
  // itself.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "strapi-launchpad-web-stage" },
  ],
}
