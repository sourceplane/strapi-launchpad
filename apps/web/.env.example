# Local settings for `pnpm --filter @app/web dev` — copy to .env.local.
# Deployed environments take theirs from Orun secrets (component.yaml); never
# commit a .env.local.

# Your Strapi project's public URL (e.g. https://<project>.strapiapp.com, or
# http://localhost:1337 for a local Strapi running LaunchPad's strapi/ app).
# Empty: the site renders its bundled sample content.
STRAPI_URL=

# Strapi's preview secret: /api/preview?secret=… turns on draft mode. Empty:
# preview is refused.
PREVIEW_SECRET=

# The origin the Open Graph images resolve against.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
